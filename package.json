    "react-simple-keyboard": "^3.8.295",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@netlify/functions": "^6.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^5.1.1",
    "baseline-browser-mapping": "^2.11.35",
    "eslint": "^9.39.1",
