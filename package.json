  "type": "module",
  "scripts": {
    "dev": "vite",
    "bump-version": "npm version patch --no-git-tag-version && git add package.json package-lock.json",
    "bump-minor": "npm version minor --no-git-tag-version && git add package.json package-lock.json",
    "build": "tsc && vite build",
